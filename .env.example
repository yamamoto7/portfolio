# Routin の問い合わせフォーム（app/api/contact）の通知先。
# Slack の Incoming Webhook URL を設定する。
# ローカル: このファイルを .env.local にコピーして値を入れる
# 本番:    Vercel のプロジェクト設定 > Environment Variables に登録
CONTACT_WEBHOOK_URL=

# アプリフィードバック受け口（app/api/feedback）。
# クローズドベータ向け。クライアントが Authorization: Bearer <KEY>
# （または x-api-key: <KEY>）で送るキー。推測されにくい乱数を設定する。
FEEDBACK_API_KEY=
# 受け取った内容の転送先。スプレッドシートに紐づけた Apps Script
# ウェブアプリの /exec URL。手順は scripts/google-apps-script/feedback-sheet.gs。
FEEDBACK_SHEET_WEBHOOK_URL=
# GAS と共有する任意のシークレット（GAS 側 SHARED_TOKEN と一致させる）。
# 空のままなら検証しない（URL のみで保護）。
FEEDBACK_SHEET_TOKEN=
